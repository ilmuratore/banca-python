# Example only: main.py reads environment variables directly.
# Copying this file to .env does NOT automatically configure the application.
# Set these values in your shell before running python main.py.
BANCA_DB_HOST=localhost
BANCA_DB_PORT=5432
BANCA_DB_NAME=banca
BANCA_DB_USER=postgres
BANCA_DB_PASSWORD=replace-with-your-local-password
# Optional: set to 1 to disable terminal screen clearing.
BANCA_NO_CLEAR=0
